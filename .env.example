# ═══════════════════════════════════════════════════════
# HADES AI OPERATING SYSTEM
# Local Environment Configuration
# ═══════════════════════════════════════════════════════
# DO NOT COMMIT THIS FILE (.env) TO VERSION CONTROL.
# Copy this file to .env and fill in the required values.

# -------------------------------------------------------
# CORE AI MODELS (Required for basic reasoning)
# -------------------------------------------------------
# Primary intelligence provider.
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback intelligence provider (Optional).
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------
# WEB RESEARCH (Required for research skills)
# -------------------------------------------------------
# Search provider API key (e.g., Tavily, SerpApi, or Brave)
# SEARCH_API_KEY=your_search_api_key_here

# -------------------------------------------------------
# PRESENTATION CREATION (Optional)
# -------------------------------------------------------
# If using Gamma via API/Browser automation
# GAMMA_EMAIL=your_gamma_email
# GAMMA_PASSWORD=your_gamma_password
# GAMMA_API_KEY=your_gamma_api_key (if officially available)

# If using Canva
# CANVA_CLIENT_ID=your_canva_client_id
# CANVA_CLIENT_SECRET=your_canva_client_secret

# -------------------------------------------------------
# PRODUCTIVITY (Optional)
# -------------------------------------------------------
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# -------------------------------------------------------
# LOCAL CONFIGURATION
# -------------------------------------------------------
# HADES_ENV=development
