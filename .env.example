# ═══════════════════════════════════════════════════════
# HADES AI OPERATING SYSTEM — CREDENTIALS & WORKERS (.env)
# ═══════════════════════════════════════════════════════
# DO NOT COMMIT SECRETS TO VERSION CONTROL.
# Copy this file to .env and fill in your keys.

# 1. FREE & OPEN-SOURCE WORKER PROVIDERS
# Google AI Studio (Free Tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Ultra-Fast Free Tier for Llama 3.3 70B & Mixtral): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Free open-source models): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama (100% Free, Private, Offline — No API key needed)
OLLAMA_API_BASE=http://localhost:11434

# 2. COMMERCIAL / REASONING WORKERS (Optional)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. WEB SEARCH & RESEARCH SKILLS (Optional)
# Tavily Search (Free 1,000 searches/mo): https://tavily.com
SEARCH_API_KEY=your_search_api_key_here
